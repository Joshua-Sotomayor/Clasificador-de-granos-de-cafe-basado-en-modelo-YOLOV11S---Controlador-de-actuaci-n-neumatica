# ==========================================================
# CONFIGURACIÓN DEL SISTEMA DE CLASIFICACIÓN MOPPI
# Finca Alvizua - Clasificador Óptico en Tiempo Real
# ==========================================================

# Conexión a MongoDB Atlas (Dejar vacío para operar en modo local/offline)
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=moppi_clasificador
MONGO_COLLECTION=resumenes_lotes

# Configuración de Inferencia YOLO
MODEL_PATH=models/best.pt
MODEL_13CLASES_PATH=models/best_13clases.pt
CONFIDENCE_THRESHOLD=0.35
CAMERA_SOURCE=0
CAMERA_SOURCE_TOP=0
CAMERA_SOURCE_BOTTOM=1
CAMERA_MATCHING_X_TOLERANCE_PX=25

# Parámetros Electromecánicos
HARDWARE_POWER_KW=0.5
LOT_TIMEOUT_SECONDS=120
PNEUMATIC_VALVE_LATENCY_LIMIT_MS=35.0

# Comunicación Serial ESP32 y Actuación Neumática
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
PNEUMATIC_PULSE_MS=20
SERIAL_SIMULATION_MODE=False

# Geometría y Cinemática de Banda Transportadora
BELT_SPEED_M_S=1.5
PIXELS_PER_METER_Y=6400
Y_NOZZLE_PX=530
VALVE_RESPONSE_TIME_MS=3.0

# Parámetros HMI Táctil
HMI_FULLSCREEN=True
HMI_WIDTH=1280
HMI_HEIGHT=800
